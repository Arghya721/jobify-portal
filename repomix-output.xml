  --sidebar-primary: oklch(0.488 0.243 264.376);
  --sidebar-primary-foreground: oklch(0.985 0 0);
  --sidebar-accent: oklch(0.269 0 0);
  --sidebar-accent-foreground: oklch(0.985 0 0);
  --sidebar-border: oklch(1 0 0 / 10%);
  --sidebar-ring: oklch(0.556 0 0);
}

@layer base {
  * {
    @apply border-border outline-ring/50;
  }

  html {
    scroll-behavior: smooth;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }

  body {
    @apply bg-background text-foreground;
  }

  /* Keyboard navigation: visible ring on anything focusable that doesn't
     style its own (shadcn components set their own focus-visible rings) */
  :focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }

  h1,
  h2,
  h3 {
    text-wrap: balance;
  }

  ::selection {
    background: oklch(0.696 0.17 162.48 / 30%);
    color: var(--foreground);
  }
}

/* ─── Experience layer ──────────────────────────────────────────────────── */

/* Film grain — fixed overlay, breaks digital flatness */
.noise-overlay {
  position: fixed;
  inset: 0;
  z-index: 80;
  pointer-events: none;
  opacity: 0.035;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  background-size: 256px 256px;
}

.dark .noise-overlay {
  opacity: 0.05;
}

/* Cursor spotlight card — set --mx/--my (px) from JS */
.spotlight-card {
  position: relative;
}

.spotlight-card::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.4s var(--ease-out);
  background: radial-gradient(
    340px circle at var(--mx, 50%) var(--my, 50%),
    oklch(0.696 0.17 162.48 / 0.09),
    transparent 65%
  );
}

.spotlight-card:hover::before {
  opacity: 1;
}

/* Spotlight border — illuminated 1px edge under cursor */
.spotlight-border {
  position: relative;
}

.spotlight-border::after {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  pointer-events: none;
  padding: 1px;
  opacity: 0;
  transition: opacity 0.4s var(--ease-out);
  background: radial-gradient(
    260px circle at var(--mx, 50%) var(--my, 50%),
    oklch(0.696 0.17 162.48 / 0.55),
    transparent 70%
  );
  -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;
}

.spotlight-border:hover::after {
  opacity: 1;
}

/* Outlined display text — fills on hover/scroll */
.text-stroke {
  -webkit-text-stroke: 1.5px oklch(0.696 0.17 162.48 / 0.35);
  color: transparent;
  transition: color 0.6s var(--ease-out), -webkit-text-stroke-color 0.6s var(--ease-out);
}

.text-stroke-fill:hover,
.text-stroke.is-filled {
  color: oklch(0.696 0.17 162.48 / 0.9);
  -webkit-text-stroke-color: transparent;
}

/* Marquee strips (shared) */
@keyframes marquee-left {
  from { transform: translateX(0); }
  to   { transform: translateX(-50%); }
}

@keyframes marquee-right {
  from { transform: translateX(-50%); }
  to   { transform: translateX(0); }
}

/* Slow conic border rotation for the hero search glow */
@property --glow-angle {
  syntax: "<angle>";
  initial-value: 0deg;
  inherits: false;
}

@keyframes glow-rotate {
  to { --glow-angle: 360deg; }
}

.glow-ring {
  position: relative;
}

.glow-ring::before {
  content: "";
  position: absolute;
  inset: -1px;
  z-index: -1;
  border-radius: inherit;
  background: conic-gradient(
    from var(--glow-angle),
    transparent 0%,
    oklch(0.696 0.17 162.48 / 0.5) 12%,
    transparent 26%,
    transparent 55%,
    oklch(0.765 0.177 163.223 / 0.35) 68%,
    transparent 82%
  );
  animation: glow-rotate 6s linear infinite;
  opacity: 0;
  transition: opacity 0.5s var(--ease-out);
}

.glow-ring:focus-within::before,
.glow-ring:hover::before {
  opacity: 1;
}

/* Scroll cue line */
@keyframes scroll-cue {
  0%   { transform: scaleY(0); transform-origin: top; }
  45%  { transform: scaleY(1); transform-origin: top; }
  55%  { transform: scaleY(1); transform-origin: bottom; }
  100% { transform: scaleY(0); transform-origin: bottom; }
}

.scroll-cue-line {
  animation: scroll-cue 2.2s var(--ease-in-out) infinite;
}

@media (prefers-reduced-motion: reduce) {
  .glow-ring::before,
  .scroll-cue-line {
    animation: none;
  }
}

/* Custom scrollbar */
::-webkit-scrollbar {
  width: 6px;
}

::-webkit-scrollbar-track {
  background: transparent;
}

::-webkit-scrollbar-thumb {
  background: oklch(0.35 0 0);
  border-radius: 3px;
}

::-webkit-scrollbar-thumb:hover {
  background: oklch(0.45 0 0);
}

/* ─── Ambient orb animations (hero background) ─────────────────────────── */

@keyframes orb-drift-a {
  0%, 100% { transform: translate(0px, 0px) scale(1); }
  33%       { transform: translate(40px, -30px) scale(1.06); }
  66%       { transform: translate(-25px, 45px) scale(0.94); }
}

@keyframes orb-drift-b {
  0%, 100% { transform: translate(0px, 0px) scale(1); }
  50%       { transform: translate(-50px, 25px) scale(1.1); }
}

@keyframes orb-drift-c {
  0%, 100% { transform: translate(0px, 0px) scale(1); }
  40%       { transform: translate(30px, 40px) scale(0.92); }
  80%       { transform: translate(-20px, -30px) scale(1.04); }
}

.orb-a { animation: orb-drift-a 18s ease-in-out infinite; }
.orb-b { animation: orb-drift-b 24s ease-in-out infinite; }
.orb-c { animation: orb-drift-c 20s ease-in-out infinite; }
.orb-d { animation: orb-drift-d 26s ease-in-out infinite; }
.orb-e { animation: orb-drift-e 21s ease-in-out infinite; }

@keyframes orb-drift-d {
  0%, 100% { transform: translate(0px, 0px) scale(1); }
  35%       { transform: translate(-40px, 55px) scale(1.07); }
  70%       { transform: translate(50px, -25px) scale(0.95); }
}

@keyframes orb-drift-e {
  0%, 100% { transform: translate(0px, 0px) scale(1); }
  45%       { transform: translate(60px, -45px) scale(1.06); }
  85%       { transform: translate(-35px, 35px) scale(0.96); }
}

@media (prefers-reduced-motion: reduce) {
  .orb-a, .orb-b, .orb-c, .orb-d, .orb-e { animation: none; }
}

/* AnimatedList transitions */
.job-card-enter {
  opacity: 0;
  transform: translateY(8px);
  animation: slideIn 0.3s ease-out forwards;
}

@keyframes slideIn {
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes ai-shimmer {
  0%   { background-position: 200% center; }
  100% { background-position: -200% center; }
}

/* ─── View Transitions ──────────────────────────────────────────────────── */

/* Root page cross-fade */
::view-transition-old(root) {
  animation: 220ms ease-out both vt-fade-out;
}
::view-transition-new(root) {
  animation: 300ms ease-out both vt-fade-in;
}

/* Named elements (job cards ↔ detail hero) morph */
::view-transition-old(*),
::view-transition-new(*) {
  animation-duration: 350ms;
  animation-timing-function: var(--ease-out);
}

@media (prefers-reduced-motion: reduce) {
  ::view-transition-old(root),
  ::view-transition-new(root),
  ::view-transition-old(*),
  ::view-transition-new(*) {
    animation-duration: 0.01ms !important;
  }

  .job-card-enter {
    animation: none;
    opacity: 1;
    transform: none;
  }
}

@keyframes vt-fade-out {
  from { opacity: 1; transform: translateY(0); }
  to   { opacity: 0; transform: translateY(-6px); }
}

@keyframes vt-fade-in {
  from { opacity: 0; transform: translateY(8px); }
  to   { opacity: 1; transform: translateY(0); }
}
</file>

